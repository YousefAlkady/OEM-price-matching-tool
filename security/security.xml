<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_tecdoc" model="ir.module.category">
        <field name="name">OEM Connect</field>
        <field name="sequence">50</field>
    </record>

    <!-- Viewer: read the catalog. Operator: paid searches, import, add to catalog. Manager: delete, logs, settings-level data. -->
    <record id="group_tecdoc_viewer" model="res.groups">
        <field name="name">Viewer</field>
        <field name="category_id" ref="module_category_tecdoc"/>
    </record>
    <record id="group_tecdoc_operator" model="res.groups">
        <field name="name">Operator</field>
        <field name="category_id" ref="module_category_tecdoc"/>
        <field name="implied_ids" eval="[(4, ref('group_tecdoc_viewer'))]"/>
    </record>
    <record id="group_tecdoc_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_tecdoc"/>
        <field name="implied_ids" eval="[(4, ref('group_tecdoc_operator'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
