<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tecdoc_api_log_tree" model="ir.ui.view">
        <field name="name">tecdoc.api.log.tree</field>
        <field name="model">tecdoc.api.log</field>
        <field name="arch" type="xml">
            <list decoration-danger="status == 'error'" decoration-success="status == 'success'">
                <field name="create_date"/>
                <field name="endpoint"/>
                <field name="response_code"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_tecdoc_api_log_form" model="ir.ui.view">
        <field name="name">tecdoc.api.log.form</field>
        <field name="model">tecdoc.api.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="endpoint"/>
                            <field name="status"/>
                            <field name="response_code"/>
                        </group>
                        <group>
                            <field name="create_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payload/Params">
                            <field name="payload"/>
                        </page>
                        <page string="Error Message">
                            <field name="error_message"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tecdoc_api_log" model="ir.actions.act_window">
        <field name="name">API Logs</field>
        <field name="res_model">tecdoc.api.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_tecdoc_api_log"
              name="API Logs"
              parent="menu_tecdoc_root"
              action="action_tecdoc_api_log"
              sequence="50"/>
</odoo>
