<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tecdoc_vehicle_tree" model="ir.ui.view">
        <field name="name">tecdoc.vehicle.tree</field>
        <field name="model">tecdoc.vehicle</field>
        <field name="arch" type="xml">
            <tree>
                <field name="brand"/>
                <field name="vehicle_model"/>
                <field name="type"/>
                <field name="vin"/>
                <field name="make_date"/>
            </tree>
        </field>
    </record>

    <record id="view_tecdoc_vehicle_form" model="ir.ui.view">
        <field name="name">tecdoc.vehicle.form</field>
        <field name="model">tecdoc.vehicle</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_parts" type="object" class="oe_stat_button" icon="fa-cogs">
                            <field name="parts_count" widget="statinfo" string="Parts"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Vehicle Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="brand"/>
                            <field name="vehicle_model"/>
                            <field name="type"/>
                        </group>
                        <group>
                            <field name="vin"/>
                            <field name="make_date"/>
                            <field name="vehicle_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Compatible Parts">
                            <field name="part_ids">
                                <tree>
                                    <field name="brand"/>
                                    <field name="part_number"/>
                                    <field name="name"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
