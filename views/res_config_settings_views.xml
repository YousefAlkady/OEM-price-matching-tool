<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.tecdoc</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="TecDoc" string="TecDoc Integration" name="tecdoc_integration" groups="base.group_system">
                    <block title="RapidAPI Settings" name="tecdoc_rapidapi_settings">
                        <setting string="API Key" help="Your RapidAPI Key for Auto Parts Catalog">
                            <field name="tecdoc_rapidapi_key" password="True"/>
                        </setting>
                        <setting string="API Host" help="The host for the RapidAPI Auto Parts Catalog">
                            <field name="tecdoc_rapidapi_host"/>
                        </setting>
                    </block>
                    <block title="Usage and Cost Control" name="tecdoc_usage_settings">
                        <setting string="Calls This Month" help="Billed RapidAPI calls this month for this company">
                            <field name="tecdoc_calls_this_month"/>
                        </setting>
                        <setting string="Monthly Call Budget" help="Hard stop after this many billed calls per month (0 = no cap)">
                            <field name="tecdoc_monthly_call_budget"/>
                        </setting>
                        <setting string="Calls per User per Minute" help="Per-user limit on billed calls (0 = no limit)">
                            <field name="tecdoc_user_calls_per_minute"/>
                        </setting>
                        <setting string="Cache Lifetime (days)" help="How long an API response is reused before refetching">
                            <field name="tecdoc_cache_ttl_days"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_tecdoc_configuration" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'tecdoc_integration'}</field>
    </record>

    <menuitem id="menu_tecdoc_configuration"
              name="Configuration"
              parent="menu_tecdoc_root"
              sequence="100"/>

    <menuitem id="menu_tecdoc_settings"
              name="Settings"
              parent="menu_tecdoc_configuration"
              action="action_tecdoc_configuration"
              sequence="10"/>
</odoo>
