<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tecdoc_import_wizard_form" model="ir.ui.view">
        <field name="name">tecdoc.import.wizard.form</field>
        <field name="model">tecdoc.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Parts">
                <group>
                    <field name="filename" invisible="1"/>
                    <field name="file" filename="filename" string="CSV File"/>
                </group>
                <p class="text-muted">
                    Upload a CSV file where the first column contains OEM or Part Numbers.
                    Maximum 100 parts per import to prevent timeouts.
                </p>
                <footer>
                    <button name="action_import" string="Import" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_tecdoc_import_wizard" model="ir.actions.act_window">
        <field name="name">Batch Import Parts</field>
        <field name="res_model">tecdoc.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_tecdoc_import_wizard"
              name="Batch Import"
              parent="menu_tecdoc_root"
              action="action_tecdoc_import_wizard"
              sequence="30"/>
</odoo>
