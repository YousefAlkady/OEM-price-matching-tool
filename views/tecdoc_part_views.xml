<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_bulk_fetch_parts" model="ir.actions.server">
        <field name="name">Deep Search Missing Info (Bulk)</field>
        <field name="model_id" ref="model_tecdoc_part"/>
        <field name="binding_model_id" ref="model_tecdoc_part"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            if records:
                records.action_fallback_search_missing_info()
        </field>
    </record>

    <record id="action_bulk_create_products" model="ir.actions.server">
        <field name="name">Create/Sync Odoo Products (Bulk)</field>
        <field name="model_id" ref="model_tecdoc_part"/>
        <field name="binding_model_id" ref="model_tecdoc_part"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            if records:
                records.action_create_odoo_product()
        </field>
    </record>

    <record id="view_tecdoc_part_tree" model="ir.ui.view">
        <field name="name">tecdoc.part.tree</field>
        <field name="model">tecdoc.part</field>
        <field name="arch" type="xml">
            <list>
                <field name="part_number"/>
                <field name="name"/>
                <field name="brand"/>
                <field name="oem_number" optional="hide"/>
                <field name="category" optional="show"/>
                <field name="product_tmpl_id"/>
                <field name="vehicle_ids" widget="many2many_tags" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_tecdoc_part_form" model="ir.ui.view">
        <field name="name">tecdoc.part.form</field>
        <field name="model">tecdoc.part</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_refetch_all_data" string="Refetch &amp; Sync Data" type="object" class="oe_highlight" invisible="article_id == False" help="Re-parses missing OEM numbers, fetches missing alternatives/vehicles, and syncs to Odoo Product."/>
                    <button name="action_fallback_search_missing_info" string="Deep Search Missing Info" type="object" class="btn-warning" help="If normal fetch failed, tries to find missing info using part number or alternative OEMs." confirm="Are you sure you want to run a deep search? This may use additional RapidAPI credits."/>
                    <button name="action_create_odoo_product" string="Create Odoo Product" type="object" invisible="product_tmpl_id != False"/>
                    <button name="action_fetch_cross_references" string="Fetch Alternatives" type="object" invisible="article_id == False"/>
                    <button name="action_fetch_linked_vehicles" string="Fetch Compatible Vehicles" type="object" invisible="article_id == False"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_odoo_product" type="object" class="oe_stat_button" icon="fa-box" invisible="not product_tmpl_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Odoo</span>
                                <span class="o_stat_text">Product</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Part Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="part_number"/>
                            <field name="oem_number"/>
                            <field name="brand"/>
                        </group>
                        <group>
                            <field name="category"/>
                            <field name="product_tmpl_id"/>
                            <field name="vehicle_model"/>
                            <field name="vin"/>
                            <field name="article_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Images">
                            <field name="image_ids">
                                <list>
                                    <field name="image" widget="image" options="{'size': [64, 64]}"/>
                                    <field name="name"/>
                                    <field name="image_url"/>
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <field name="name"/>
                                            <field name="image_url"/>
                                            <field name="image" widget="image" class="oe_avatar"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Cross References">
                            <field name="cross_reference_ids">
                                <list>
                                    <field name="brand"/>
                                    <field name="oem_number"/>
                                </list>
                            </field>
                        </page>
                        <page string="Compatible Vehicles">
                            <field name="vehicle_ids">
                                <list>
                                    <field name="brand"/>
                                    <field name="vehicle_model"/>
                                    <field name="make_date"/>
                                    <field name="type"/>
                                    <field name="vin"/>
                                </list>
                            </field>
                        </page>
                        <page string="Raw Data">
                            <field name="raw_data"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tecdoc_part_search" model="ir.ui.view">
        <field name="name">tecdoc.part.search</field>
        <field name="model">tecdoc.part</field>
        <field name="arch" type="xml">
            <search>
                <field name="part_number" 
                       string="Any Match" 
                       filter_domain="['|', '|', ('part_number', 'ilike', self), ('oem_number', 'ilike', self), ('name', 'ilike', self)]"/>
                <field name="oem_number"/>
                <field name="name" string="Part Name"/>
                <field name="vin" string="VIN"/>
                <field name="vehicle_ids" string="Vehicle Model" filter_domain="[('vehicle_ids.vehicle_model', 'ilike', self)]"/>
                <field name="brand"/>
            </search>
        </field>
    </record>

    <record id="action_tecdoc_parts" model="ir.actions.act_window">
        <field name="name">TecDoc Parts</field>
        <field name="res_model">tecdoc.part</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_tecdoc_root"
              name="TecDoc Parts"
              sequence="10"/>

    <menuitem id="menu_tecdoc_parts"
              name="Parts Database"
              parent="menu_tecdoc_root"
              action="action_tecdoc_parts"
              sequence="10"/>

    <record id="action_tecdoc_vehicles" model="ir.actions.act_window">
        <field name="name">Vehicles Database</field>
        <field name="res_model">tecdoc.vehicle</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_tecdoc_vehicles"
              name="Vehicles Database"
              parent="menu_tecdoc_root"
              action="action_tecdoc_vehicles"
              sequence="20"/>
</odoo>
